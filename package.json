{
  "name": "chatterkit",
  "version": "1.0.3",
  "description": "A React TypeScript chatbot and chat widget library for embeddable FAQ bots, AI chat, and support assistants.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "private": false,
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelpelagio9830/chatterkit.git"
  },
  "homepage": "https://github.com/michaelpelagio9830/chatterkit#readme",
  "bugs": {
    "url": "https://github.com/michaelpelagio9830/chatterkit/issues"
  },
  "sideEffects": [
    "./dist/style.css",
    "./src/style.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:js && npm run build:css && npm run build:types",
    "build:js": "cross-env CHATTERKIT_LIBRARY_BUILD=true vite build",
    "build:css": "cross-env CHATTERKIT_LIBRARY_BUILD=true tailwindcss -i ./src/style.css -o ./dist/style.css --minify",
    "build:types": "tsc -p tsconfig.build.json",
    "verify:css": "node scripts/verify-css-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "chatbot",
    "react",
    "react-chatbot",
    "react-chat-widget",
    "chat-widget",
    "chatbot-widget",
    "tailwind",
    "typescript",
    "component",
    "faq",
    "faq-bot",
    "ai-chat",
    "support-widget",
    "customer-support",
    "openapi"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
